# Public / safe-to-commit values.
# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Production: the VITE_* values go in Cloudflare (Settings -> Environment variables)
# as build variables. Server secrets go in with `npx wrangler secret put <NAME>`.

SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only, NOT used by the browser bundle. Set with `npx wrangler secret put`:
#   GEMINI_API_KEY            Google Gemini (AI coach, daily quiz, PDF parsing)
#   SUPABASE_SERVICE_ROLE_KEY Service-role client, bypasses RLS
#   FIREBASE_SERVICE_ACCOUNT  FCM push notifications (JSON string)
